# Local decision Agent configuration. Create .env from this template if needed.
# Set credentials locally. Cloud requests also require explicit CLI opt-in.

DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
FALLPRE_DECISION_MODEL=decision-model-preview

# off | mock | aliyun ; real network calls require aliyun explicitly.
FALLPRE_DECISION_PROVIDER=off
# tail_joint | cd for structured replay. The browser service uses --fall-head cd.
FALLPRE_FALL_HEAD=tail_joint

# Decision timing and retry defaults.
FALLPRE_DECISION_TIMEOUT_S=3.0
FALLPRE_DECISION_MAX_RETRIES=1
FALLPRE_DECISION_MIN_INTERVAL_S=2.0
FALLPRE_DECISION_MAX_SOURCE_AGE_S=2.5
FALLPRE_DECISION_MAX_WALL_AGE_S=5.0
FALLPRE_DECISION_MAX_REOBSERVATIONS=1
FALLPRE_AGENT_DB=runs/agent/agent.sqlite3
