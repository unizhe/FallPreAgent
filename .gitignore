# Repository publication boundary: new top-level areas are reviewed explicitly.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/CONTRIBUTING.md
!/pyproject.toml
!/uv.lock
!/sources.lock.json
!/models.lock.json
!/algorithm-sources.2026-10-14.v1.json
!/requirements-weekly*.txt
!/src/
!/scripts/
!/tests/
!/configs/
!/assets/
!/docs/
!/.github/

# Only application UI assets; datasets and recordings stay local.
/assets/*
!/assets/webcam/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/DEVELOPMENT.md
!/docs/GITHUB_PREPARATION.md
!/docs/care-agent-20261110.md
!/docs/agent-decision-loop-plan-20261117.md
!/docs/agent-development-stage-01-20261117.md
!/docs/agent-development-stage-02-20261117.md
!/docs/agent-development-stage-03-20261117.md
!/docs/agent-development-stage-04-20261117.md
!/docs/agent-development-stage-05-20261118.md
!/docs/agent-observation-envelope-v1.example.json
!/docs/assets/
/docs/assets/*
!/docs/assets/single-agent-tools-20261111.html
/configs/*
!/configs/*.json

# Local configuration, credentials, environments and generated state.
**/.DS_Store
**/.env
**/.env.*
!**/.env.example
**/*.local.*
**/*credentials*.json
**/*service-account*.json
**/*.pem
**/*.key
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
**/.venv/
**/*.sqlite3*
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.log

# No media, archives, model weights or feature caches in the source repository.
*.zip
*.tar
*.tgz
*.gz
*.mp4
*.mov
*.webm
*.avi
*.mkv
*.jpg
*.jpeg
*.png
*.webp
*.pt
*.pth
*.onnx
*.npz
*.npy
*.pkl
*.pickle
*.safetensors
