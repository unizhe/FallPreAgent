{
  "schema": "five-action-public-video/1",
  "dataset": "URFD + HADE small fixed clip split",
  "name": "Five-action pilot, 22 public clips, 2026-10-15",
  "annotation_status": "agent_visual_provisional_requires_human_review",
  "independent_human_annotators": 0,
  "frozen_before_model_evaluation": true,
  "clock": "Encoded video frame_index / inspected average FPS; not the URFD sensor synchronization clock. HADE original video frame rates vary.",
  "split_policy": "11 train and 11 test complete source video groups, fixed before viewing model predictions; no source clip is split between train and test. This is NOT a subject-disjoint or scene-disjoint benchmark.",
  "label_policy": {
    "walking": "Visible bipedal locomotion, includes turning while moving; excludes stationary standing.",
    "sitting_down": "Transition from standing to a chair, sofa or stool seat; excludes static sitting and squatting to the floor.",
    "standing_up": "Transition from a chair, sofa or stool seat to upright; excludes straightening after bending or rising from floor.",
    "bending": "Intentional trunk flexion while remaining supported on feet, including the return phase of the bending action.",
    "falling": "Visible staged falling transition toward the ground; static lying after landing is background.",
    "background": "Visible stationary standing/seated/lying or other reviewed non-target state.",
    "unknown": "Unannotated gaps/ambiguous boundaries are excluded from supervised target labels.",
    "boundaries": "Intervals are half-open [start_s,end_s); coarse visual boundary uncertainty approximately 0.13–0.2 seconds; not clinical onset labels."
  },
  "sources": [
    {
      "name": "UR Fall Detection",
      "url": "https://fenix.ur.edu.pl/~mkepski/ds/uf.html",
      "citation": "Kwolek & Kepski, Human fall detection on embedded platform using depth maps and wireless accelerometer, CMPB 117(3), 2014, 489–501.",
      "license": "CC BY-NC-SA 4.0; non-commercial academic research"
    },
    {
      "name": "HADE",
      "url": "https://zenodo.org/records/8223591",
      "doi": "10.5281/zenodo.8223591",
      "citation": "Misha Karim (2023), Human-Actions-in-Diverse-Environments-HAR-Approach, Zenodo.",
      "license": "CC BY 4.0",
      "metadata_snapshot": "runs/five-action-20261015/inputs/zenodo-8223591.json"
    }
  ],
  "limitations": [
    "Pilot support is two training and two held-out source clips for the least-supported classes; not a representative accuracy estimate.",
    "Repeated actors and rooms occur across train/test. HADE source-group provenance beyond published filenames is unknown; the split does not establish independent subjects.",
    "Standing-up support is HADE only; bending/falling support is URFD only. Domain/class confounding remains despite including HADE sit/walk/background.",
    "URFD falls are staged, not clinical falls. Five-class intervals were visually annotated by a coding agent without human adjudication; no official five-class timing ground truth is claimed.",
    "Official URFD preview videos use lossy side-by-side depth/RGB encoding; this subset crops only RGB and re-encodes for the baseline.",
    "Some HADE videos have variable frame timing; this pilot uses their encoded average-FPS frame clock and does not claim precise real-world transition latency."
  ],
